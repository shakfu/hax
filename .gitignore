# Meson build directories (any build* dir at repo root)
/build*/

.cache/
*.o
*.swp
*.swo
.DS_Store
__pycache__/

# clang static-analyzer output
*.plist

# cffi build products and the uv environment for the Python binding
/bindings/python/_hax_cffi*
/bindings/python/*.o
/.venv/

# Wheel build output, and the build directory meson-python leaves behind on a failed build
/dist/
/.mesonpy-*/

# Wrap subprojects are fetched at build time; only the .wrap files are tracked
/subprojects/*
!/subprojects/*.wrap
